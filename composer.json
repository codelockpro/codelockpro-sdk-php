{
	"name": "codelockpro/sdk",
	"description": "Framework-agnostic, modular server-side SDK for CodeLockPro. Module one: Knowledge base. Pure library — no framework binding, no routing.",
	"type": "library",
	"license": "proprietary",
	"homepage": "https://github.com/codelockpro/codelockpro/tree/main/sdk/php#readme",
	"support": {
		"issues": "https://github.com/codelockpro/codelockpro/issues",
		"source": "https://github.com/codelockpro/codelockpro-sdk-php"
	},
	"authors": [
		{
			"name": "CodeLockPro",
			"homepage": "https://codelock.pro"
		}
	],
	"require": {
		"php": ">=8.1",
		"ext-curl": "*",
		"ext-json": "*"
	},
	"autoload": {
		"psr-4": {
			"CodeLockPro\\": "src/"
		}
	},
	"keywords": [
		"codelockpro",
		"sdk",
		"knowledge-base",
		"licensing"
	],
	"minimum-stability": "stable"
}
